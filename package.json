{
  "name": "biolab3d",
  "version": "0.1.0",
  "private": true,
  "description": "BioLab 3D \u2014 A Biologia ganha vida na sua aula.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "keys:create": "tsx --conditions=react-server scripts/keys.mts create",
    "keys:list": "tsx --conditions=react-server scripts/keys.mts list",
    "keys:revoke": "tsx --conditions=react-server scripts/keys.mts revoke",
    "keys:export": "tsx --conditions=react-server scripts/keys.mts export"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "^15.5.29",
    "react": "19.1",
    "react-dom": "19.1",
    "server-only": "^0.0.1",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.18",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}

# Modo simples (em uso): uma chave fixa por plano. Com estas duas, nada mais é obrigatório.
BIOLAB_KEY_BASICO=
BIOLAB_KEY_COMPLETO=

# Segredo para assinar sessões (mín. 32 bytes aleatórios). Gere com: openssl rand -base64 48
BIOLAB_SESSION_SECRET=
# "Pepper" para o HMAC das chaves de acesso (diferente do segredo de sessão).
BIOLAB_KEY_PEPPER=
# Onde o armazenamento de chaves em arquivo grava os registros (apenas desenvolvimento / servidor único).
BIOLAB_KEYSTORE_PATH=.data/keys.json
# Na Vercel (sem disco persistente): saída de `npm run keys:export` (só hashes). Tem prioridade sobre o arquivo.
BIOLAB_KEYS=
